# v16 resolution-aware schedule on A100 full-res bicycle.
#
# Replaces fixed v15 E1b iteration boundaries with RAS planner output.
# Loss weights remain aligned with v15 late_stabilize / E1b recipe.
#
# Usage (repo root on A100):
#   source scripts/configs/bicycle_v16_resolution_aware.env
#   bash scripts/run_bicycle_v16_resolution_aware.sh
#
# Planner only (disable runtime adaptive extension):
#   VARIANT=planner_only bash scripts/run_bicycle_v16_resolution_aware.sh

export VARIANT="${VARIANT:-auto}"
export ITERATIONS="${ITERATIONS:-30000}"
export RESOLUTION="${RESOLUTION:--1}"
export IMAGES="${IMAGES:-images}"

export SOURCE="${SOURCE:-/root/highspeedstorage/TAGS-A100/data/bicycle}"
export DEPTHS="${DEPTHS:-/root/highspeedstorage/TAGS-A100/data/bicycle/depth_any_out}"
export OUTPUT_ROOT="${OUTPUT_ROOT:-/root/highspeedstorage/TAGS-A100/TAGSs/output/v16_resolution_aware_a100}"
export CASE_NAME="${CASE_NAME:-bicycle_v16_a100_resolution_aware}"

export RUN_TRAIN="${RUN_TRAIN:-1}"
export RUN_RENDER_METRICS="${RUN_RENDER_METRICS:-1}"
export SKIP_COMPLETED="${SKIP_COMPLETED:-1}"
export GPU_ID="${GPU_ID:-0}"

export TAGGS_CPU_KNN_INIT="${TAGGS_CPU_KNN_INIT:-1}"
export TAGGS_DENSIFY_EMPTY_CACHE="${TAGGS_DENSIFY_EMPTY_CACHE:-1}"
export TAGGS_DENSIFY_INTERVAL_POINT_THRESHOLD="${TAGGS_DENSIFY_INTERVAL_POINT_THRESHOLD:-50000}"
export TAGGS_DENSIFY_INTERVAL_MULT_FULLRES="${TAGGS_DENSIFY_INTERVAL_MULT_FULLRES:-2}"

export PSNR_DROP_THRESHOLD="${PSNR_DROP_THRESHOLD:-0.05}"
export PERCEPTUAL_PSNR_BUDGET="${PERCEPTUAL_PSNR_BUDGET:-0.10}"
export CHRONIC_TRIPLE_LIMIT="${CHRONIC_TRIPLE_LIMIT:-1}"

# RAS knobs (override for ablations)
export RAS_REF_PIXELS="${RAS_REF_PIXELS:-0}"
export RAS_SCALE_MIN="${RAS_SCALE_MIN:-1.0}"
export RAS_SCALE_MAX="${RAS_SCALE_MAX:-2.5}"
export RAS_DENSIFY_BASE="${RAS_DENSIFY_BASE:-7200}"
export RAS_DENSIFY_MIN="${RAS_DENSIFY_MIN:-10000}"
export RAS_DENSIFY_MAX="${RAS_DENSIFY_MAX:-18000}"
export RAS_SPA_DELAY="${RAS_SPA_DELAY:-2000}"
export ADAPTIVE_DENSIFY_EXTEND_STEP="${ADAPTIVE_DENSIFY_EXTEND_STEP:-2000}"
export ADAPTIVE_DENSIFY_MAX_ITER="${ADAPTIVE_DENSIFY_MAX_ITER:-18000}"
export ADAPTIVE_POINT_BUDGET="${ADAPTIVE_POINT_BUDGET:-8000000}"

# late_stabilize weights (same as v15 E1b)
export LATE_STABILIZE_LR_GEO_MULT_STAGE3="${LATE_STABILIZE_LR_GEO_MULT_STAGE3:-0.40}"
export LATE_STABILIZE_LR_COLOR_MULT_STAGE3="${LATE_STABILIZE_LR_COLOR_MULT_STAGE3:-0.55}"
export LATE_STABILIZE_LPIPS_WEIGHT_FINAL="${LATE_STABILIZE_LPIPS_WEIGHT_FINAL:-0.006}"
export LATE_STABILIZE_LPIPS_MAX_WEIGHT="${LATE_STABILIZE_LPIPS_MAX_WEIGHT:-0.010}"
export LATE_STABILIZE_LPIPS_INTERVAL="${LATE_STABILIZE_LPIPS_INTERVAL:-10}"
export LATE_STABILIZE_COLOR_ALIGN_WEIGHT_FINAL="${LATE_STABILIZE_COLOR_ALIGN_WEIGHT_FINAL:-0.0010}"
export LATE_STABILIZE_COLOR_ALIGN_MAX_WEIGHT="${LATE_STABILIZE_COLOR_ALIGN_MAX_WEIGHT:-0.0020}"
export LATE_STABILIZE_PSNR_WEIGHT_FINAL="${LATE_STABILIZE_PSNR_WEIGHT_FINAL:-0.008}"
export LATE_STABILIZE_PSNR_MAX_WEIGHT="${LATE_STABILIZE_PSNR_MAX_WEIGHT:-0.012}"

echo "Loaded v16 resolution-aware env: CASE_NAME=${CASE_NAME} VARIANT=${VARIANT} IMAGES=${IMAGES} RESOLUTION=${RESOLUTION}"
